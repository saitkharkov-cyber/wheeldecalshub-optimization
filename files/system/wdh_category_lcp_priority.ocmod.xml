<?xml version="1.0" encoding="utf-8"?>
<modification>
    <code>wdh_category_lcp_priority</code>
    <name>WDH Category LCP Priority</name>
    <version>1.0</version>
    <author>WheelDecalsHub Optimization</author>
    <file path="catalog/view/theme/tt_uren1/template/product/category.twig">
        <operation>
            <search><![CDATA[<img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive img-default-image" />]]></search>
            <add position="replace"><![CDATA[<img src="{{ product.thumb }}"{% if '-180x180.webp' in product.thumb %} srcset="{{ product.thumb }} 180w, {{ product.thumb|replace({'-180x180.webp':'-320x320.webp'}) }} 320w" sizes="174px" width="180" height="180"{% else %} width="320" height="320"{% endif %}{% if loop.index == 1 %} fetchpriority="high"{% elseif loop.index > 2 %} loading="lazy" decoding="async"{% endif %} alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive img-default-image" />]]></add>
        </operation>
    </file>
</modification>


