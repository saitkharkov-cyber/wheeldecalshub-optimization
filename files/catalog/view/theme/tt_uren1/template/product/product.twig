					{% else %}
						{% set class = 'col-sm-6' %}
					{% endif %}
					<div class="{{ class }} product-image-details">
                                          {% if wdh_mobile %}
						<div class="innermovemob">
						<h1>{{ heading_title }}</h1>
						{% if review_status %}
