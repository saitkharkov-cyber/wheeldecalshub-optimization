											<input type="hidden"{% for  key, optim in image.product_option_value_id %} data-optim{{key}}="{{optim}}" {% endfor %}  data-thumb="{{ image.product_image_option }}" data-popup="{{ image.popup }}" />
										{% endfor %}
									{% endif %}
								{% endif %}
							{% else %}
								{% if thumb or images %}
									<ul class="thumbnails">
