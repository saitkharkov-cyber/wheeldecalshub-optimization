<script>
	document.addEventListener("DOMContentLoaded", function () {
		let touchStartX = 0;
		let touchEndX = 0;

		const modalBody = document.querySelector("#review-image-modal .modal-body");

		function handleGesture() {
			const swipeThreshold = 50;
			if (touchEndX < touchStartX - swipeThreshold) {
				// РЎРІР°Р№Рї РІР»С–РІРѕ вЂ” РЅР°СЃС‚СѓРїРЅРµ Р·РѕР±СЂР°Р¶РµРЅРЅСЏ
				document.getElementById('modal-next-btn').click();
			}
			if (touchEndX > touchStartX + swipeThreshold) {
				// РЎРІР°Р№Рї РІРїСЂР°РІРѕ вЂ” РїРѕРїРµСЂРµРґРЅС” Р·РѕР±СЂР°Р¶РµРЅРЅСЏ
				document.getElementById('modal-prev-btn').click();
			}
		}

		modalBody.addEventListener('touchstart', function (e) {
			touchStartX = e.changedTouches[0].screenX;
		}, false);

		modalBody.addEventListener('touchend', function (e) {
			touchEndX = e.changedTouches[0].screenX;
			handleGesture();
		}, false);
	});
</script>

<script>
	document.addEventListener("DOMContentLoaded", function () {
		const reviewImages = {{ review_images_list|json_encode|raw }};
		let currentIndex = null;

		function updateModal(index) {
			const data = reviewImages[index];
			if (!data) return;

			currentIndex = index;

			document.getElementById('modal-review-image').src = data.popup;
			document.getElementById('modal-review-author').innerText = data.author;
			document.getElementById('modal-review-date').innerText = data.date_added;
			document.getElementById('modal-review-text').innerHTML = data.text;

			let stars = '';
			for (let i = 1; i <= 5; i++) {
				stars += `<span class="icon-ratings"><i class="icon-rating ${i <= data.rating ? 'icon-rating-x' : 'icon-rating-o'}"></i></span>`;
			}
			document.getElementById('modal-review-rating').innerHTML = stars;

			document.getElementById('modal-product-image').src = data.product_image;
			document.getElementById('modal-product-name').innerText = data.product_name;
			document.getElementById('modal-product-link').href = data.product_href;
		}

		document.querySelectorAll(".review-image-trigger").forEach((el, index) => {
			el.addEventListener("click", function () {
				updateModal(index);
				$('#review-image-modal').modal('show');
			});
		});

		document.querySelectorAll(".review-image-trigger-all").forEach((el, index) => {
			el.addEventListener("click", function () {
				updateModal(index);
				$('#review-image-modal').modal('show');
			});
		});

		// РћР±СЂРѕР±РєР° СЃС‚СЂС–Р»РѕРє
		document.getElementById('modal-prev-btn').addEventListener("click", function () {
			if (currentIndex > 0) {
				updateModal(currentIndex - 1);
			}
		});

		document.getElementById('modal-next-btn').addEventListener("click", function () {
			if (currentIndex < reviewImages.length - 1) {
				updateModal(currentIndex + 1);
			}
		});
	});
</script>

<script>
	document.addEventListener("DOMContentLoaded", function () {
		const reviewImages = {{ review_images_list|json_encode|raw }};

		// Р¤СѓРЅРєС†С–СЏ РґР»СЏ РІС–РґРєСЂРёС‚С‚СЏ РјРѕРґР°Р»СЊРЅРѕРіРѕ РІС–РєРЅР° РїРѕ С–РЅРґРµРєСЃСѓ
		function openReviewModal(index) {
			const data = reviewImages[index];
			if (!data) return;

			document.getElementById('modal-review-image').src = data.popup;
			document.getElementById('modal-review-author').innerText = data.author;
			document.getElementById('modal-review-date').innerText = data.date_added;
			document.getElementById('modal-review-text').innerHTML = data.text;

			// Р РµР№С‚РёРЅРі
			let stars = '';
			for (let i = 1; i <= 5; i++) {
				stars += `<span class="icon-ratings"><i class="icon-rating ${i <= data.rating ? 'icon-rating-x' : 'icon-rating-o'}"></i></span>`;
			}
			document.getElementById('modal-review-rating').innerHTML = stars;

			// Р†РЅС„Рѕ РїСЂРѕ С‚РѕРІР°СЂ
			document.getElementById('modal-product-image').src = data.product_image;
			document.getElementById('modal-product-name').innerText = data.product_name;
			document.getElementById('modal-product-link').href = data.product_href;

			// РџРѕРєР°Р·Р°С‚Рё РјРѕРґР°Р»РєСѓ
			$('#review-image-modal').modal('show');
		}

		// РќР°РІС–С€СѓС”РјРѕ РЅР° РІСЃС– .review-image-trigger С– .review-image-trigger-all
		document.querySelectorAll(".review-image-trigger, .review-image-trigger-all").forEach((el) => {
			el.addEventListener("click", function () {
				const index = parseInt(el.dataset.index, 10);
				if (!isNaN(index)) {
					openReviewModal(index);
				}
			});
		});
	});
</script>

<script>
	var swiper = new Swiper('.review-images-carousel', {
